PORT=7777
JWT_SECRET=replace_with_a_long_random_secret
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/mKai2DB?retryWrites=true&w=majority
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Optional: Resend for real transactional email (welcome/enrollment emails).
# If RESEND_API_KEY is missing, the app automatically falls back to a
# throwaway Ethereal test inbox — nothing gets delivered to a real address,
# a preview link is logged to the server console per send instead.
# EMAIL_FROM must be an address on a domain verified in your Resend account
# (or the sandbox address onboarding@resend.dev before you verify one).
RESEND_API_KEY=
EMAIL_FROM="M Kai² Tech Academy" <onboarding@resend.dev>
